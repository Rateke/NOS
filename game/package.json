{
  "name": "nos-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NÓS — narrativa de exploração psicológica",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node test/playthrough.mjs",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "test:demo": "node test/demo.mjs",
    "test:all": "npm test && npm run test:demo && npm run test:mouse && npm run test:escolha && npm run test:salvar",
    "test:mouse": "node test/mouse.mjs",
    "test:escolha": "node test/escolha.mjs",
    "test:salvar": "node test/salvar.mjs"
  },
  "devDependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0"
  }
}
